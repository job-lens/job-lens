{
  "components": {
    "schemas": {
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Role": {
        "enum": [
          "learner",
          "counselor"
        ],
        "type": "string"
      },
      "User": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "maxItems": 2,
            "minItems": 1,
            "title": "Roles",
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "display_name",
          "roles"
        ],
        "title": "User",
        "type": "object"
      }
    },
    "securitySchemes": {
      "WebSession": {
        "in": "cookie",
        "name": "__Host-jl_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Job Lens API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
