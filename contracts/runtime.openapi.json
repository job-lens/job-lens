                      "title": "Status",
                      "type": "integer"
                    },
                    "title": {
                      "title": "Title",
                      "type": "string"
                    },
                    "trace_id": {
                      "title": "Trace Id",
                      "type": "string"
                    },
                    "type": {
                      "title": "Type",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                    "trace_id"
                  ],
                  "title": "Problem",
                  "type": "object"
                }
              }
            },
            "description": "Structured failure"
          }
        },
        "summary": "Health Live"
