# Template only. Never copy credentials from Windup. Securely provision separately.
JOBLENS_API_IMAGE=
JOBLENS_WEB_IMAGE=
JOBLENS_POSTGRES_IMAGE=
POSTGRES_PASSWORD=
JOB_LENS_DATABASE_URL=
# Keep s3 for an existing bucket, or explicitly select local for the JobLens-only volume.
JOB_LENS_STORAGE_KIND=s3
JOB_LENS_S3_BUCKET=
JOB_LENS_S3_REGION=
JOB_LENS_S3_ENDPOINT=
# false allows account services to start, but rejects every new upload with 503.
# No unscanned file becomes available. No scanner process is started by this stack.
JOB_LENS_SCAN_ENABLED=true
JOB_LENS_SCAN_HOST=clamav
JOB_LENS_SCAN_PORT=3310
JOB_LENS_MAIL_API_KEY=
JOB_LENS_MAIL_FROM=
# Prefer an approved workload role. No new IAM/API credentials created by this package.
