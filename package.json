{
  "name": "job-lens", "version": "0.1.0", "private": true,
  "packageManager": "pnpm@10.11.0", "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev": "pnpm --filter @job-lens/web dev",
    "build": "pnpm --filter @job-lens/web build",
    "lint": "pnpm --filter @job-lens/web lint",
    "typecheck": "pnpm --filter @job-lens/web typecheck",
    "test": "pnpm --filter @job-lens/web test",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript contracts/openapi.yaml -o apps/web/src/shared/api/schema.d.ts"
  },
  "devDependencies": {"@playwright/test": "^1.54.0", "openapi-typescript": "^7.8.0"}
}
