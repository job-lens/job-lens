POSTGRES_USER=job_lens
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=job_lens
# Percent-encode special characters in the password used in this URL.
JOB_LENS_DATABASE_URL=postgresql+psycopg://job_lens:REPLACE_WITH_ENCODED_PASSWORD@db:5432/job_lens
JOB_LENS_ENVIRONMENT=production
JOB_LENS_PUBLIC_ORIGIN=https://job-lens.example.org
JOB_LENS_TRUSTED_HOSTS=["job-lens.example.org","127.0.0.1","api"]
JOB_LENS_STORAGE_KIND=s3
JOB_LENS_S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
JOB_LENS_S3_REGION=us-east-1
# Prefer a workload IAM role. When credentials are necessary, inject them at deployment.
SITE_ADDRESS=job-lens.example.org
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
